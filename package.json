{
  "name": "round-weather-display",
  "version": "1.1.0",
  "private": true,
  "description": "Multi-target round weather display repository",
  "scripts": {
    "start": "npm --prefix targets/pi start",
    "start:pi": "npm --prefix targets/pi start",
    "test:forecast": "npm --prefix targets/pi run test:forecast",
    "test:location": "npm --prefix targets/pi run test:location",
    "test:esp32-parity": "bash targets/esp32-p4/scripts/test-weather-parity.sh",
    "test:all": "npm run test:forecast && npm run test:location && npm run test:esp32-parity"
  }
}
