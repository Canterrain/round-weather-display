# Benchmark-only tuning toward the official Waveshare LVGL demo.
# This file is intentionally layered on top of sdkconfig.defaults and
# sdkconfig.benchmark so the stable production configuration remains untouched.

# CONFIG_COMPILER_OPTIMIZATION_DEBUG is not set
# CONFIG_COMPILER_OPTIMIZATION_SIZE is not set
CONFIG_COMPILER_OPTIMIZATION_PERF=y
# CONFIG_COMPILER_OPTIMIZATION_NONE is not set

CONFIG_FREERTOS_HZ=1000

# CONFIG_CACHE_L2_CACHE_128KB is not set
CONFIG_CACHE_L2_CACHE_256KB=y
# CONFIG_CACHE_L2_CACHE_512KB is not set
# CONFIG_CACHE_L2_CACHE_LINE_64B is not set
CONFIG_CACHE_L2_CACHE_LINE_128B=y

CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y

# CONFIG_LV_USE_BUILTIN_MALLOC is not set
CONFIG_LV_USE_CLIB_MALLOC=y

# CONFIG_LV_OS_NONE is not set
CONFIG_LV_OS_FREERTOS=y

CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=2
CONFIG_LV_DEF_REFR_PERIOD=15
CONFIG_LV_USE_SYSMON=y
CONFIG_LV_USE_PERF_MONITOR=y
